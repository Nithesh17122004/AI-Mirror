# ------------------------------------------------------------------
# Texvalley I-RIS — environment template (Phase 9, production readiness)
# Copy to `.env` for local development. Never commit real secrets.
#
# ENVIRONMENT VARIABLE CATEGORIES
#   PUBLIC        — safe to expose to the browser. NONE exist in this project
#                   on purpose (no NEXT_PUBLIC_ variables). Everything below
#                   is server-only.
#   SERVER-ONLY   — read server-side only; can never reach the client bundle.
#   OPTIONAL      — use-empty-to-fall-back-to-mock.
#   REQUIRED      — must be set before ANY production sign-off.
# ------------------------------------------------------------------

# ============================ REQUIRED (production) ================
# PostgreSQL connection string (Prisma). Example:
# postgresql://iris:iris@localhost:5432/iris?schema=public
#   Category: SERVER-ONLY, REQUIRED.
DATABASE_URL=

# ============================ AUTH (NOT USED — GUEST-FIRST) ========
# Reserved for future sessions. I-RIS is intentionally guest-first: no
# account is ever required. Keep empty unless a later phase lands auth.
#   Category: SERVER-ONLY, OPTIONAL (currently unused).
NEXTAUTH_SECRET=

# Legacy reserved AI variables (unused by Phase 9 code paths).
#   Category: SERVER-ONLY, OPTIONAL (unused).
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=

# ============================ VIRTUAL TRY-ON =======================
# Provider selection. DEFAULT IS MOCK AND SAFE — no AI, no network.
#   "mock"        = simulated generation with demo-labelled output (default).
#   "fashn"       = real VTON via the FASHN AI API (requires TRY_ON_API_*).
#   "self-hosted" = real VTON via a self-hosted inference server (requires
#                   VTON_SERVER_*). "real" is accepted as a legacy alias for
#                   "fashn".
#   Category: SERVER-ONLY, OPTIONAL (default mock).
TRY_ON_PROVIDER=mock

# Real VTON provider configuration (FASHN AI API).
# Only read when TRY_ON_PROVIDER=fashn. Never expose NEXT_PUBLIC_ keys.
#   Category: SERVER-ONLY, OPTIONAL (required for fashn only).
TRY_ON_API_URL=
TRY_ON_API_KEY=

# Self-hosted VTON inference server configuration (see vton-server/).
# Only read when TRY_ON_PROVIDER=self-hosted.
#   VTON_SERVER_URL — base URL of the inference server, e.g.
#                     http://192.168.1.50:8060  (REQUIRED for self-hosted)
#   VTON_SERVER_API_KEY — shared secret sent as "Authorization: Bearer <key>".
#                     Leave empty only when the server runs without auth on a
#                     private/VPN network.
#   Category: SERVER-ONLY, OPTIONAL (required for self-hosted only).
VTON_SERVER_URL=
VTON_SERVER_API_KEY=

# ============================ AI STYLIST ===========================
# Provider selection. DEFAULT IS MOCK AND SAFE — no AI, no network.
#   "mock"   = deterministic, catalogue-grounded demo responses (default).
#              No AI, no network calls. Clearly labelled "simulated".
#   "real"   = a real LLM via an OpenAI-compatible chat-completions endpoint
#              (requires STYLIST_API_URL / STYLIST_API_KEY / STYLIST_MODEL).
#              Never auto-selected; never called by tests or builds.
#   Category: SERVER-ONLY, OPTIONAL (default mock).
STYLIST_PROVIDER=mock
# OpenAI-compatible endpoint, e.g.
#   https://api.openai.com/v1/chat/completions
# Sent server-side only; the API key is never placed in any prompt.
#   Category: SERVER-ONLY, OPTIONAL (required for real only).
STYLIST_API_URL=
STYLIST_API_KEY=
# Model name, e.g. "gpt-4o-mini". Leave empty when the endpoint supplies its
# own default. (This project's env name is STYLIST_MODEL, not STYLIST_API_MODEL.)
#   Category: SERVER-ONLY, OPTIONAL.
STYLIST_MODEL=